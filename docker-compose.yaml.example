services:
  litellm:
    image: ghcr.io/mamorett/litellm:v2.0.6
    container_name: litellm-proxy
    restart: always
    ports:
      - "4000:4000"
    extra_hosts:
      - "host.docker.internal:host-gateway"
    environment:
      - VIRTUAL_MODEL_NAME=trithemius/artemis
      - LANGFUSE_PUBLIC_KEY=${LANGFUSE_PUBLIC_KEY}
      - LANGFUSE_SECRET_KEY=${LANGFUSE_SECRET_KEY}
      - LANGFUSE_HOST=${LANGFUSE_HOST}
      - SPARK_URL=http://host.docker.internal:8000/v1/models
      # Il discovery chiama LiteLLM su localhost (stesso container)
      - LITELLM_PROXY_URL=http://localhost:4000
      # Se usi una master key su LiteLLM, mettila qui
      # - LITELLM_MASTER_KEY=sk-...
      # Chiave API per il backend Spark/Ollama
      - LITELLM_API_KEY=ollama
      - POLL_INTERVAL=10
      - BOOT_TIMEOUT=60